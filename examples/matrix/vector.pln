local m: module = {}

typealias Vector = { float }

function m.dot(u: Vector, v: Vector): float
    local sum = 0.0
    for i = 1, #u do
        sum = sum + u[i] * v[i]
    end
    return sum
end

function m.norm(v: Vector): float
    return math.sqrt(m.dot(v, v))
end

function m.scale(v: Vector, k: float): Vector
    local res: Vector = {}
    for i = 1, #v do
        res[i] = k * v[i]
    end
    return res
end

return m
