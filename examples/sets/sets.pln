local m: module = {}

typealias point = {x: integer, y: integer}

function m.newpoint(): point
	return {x = 10, y = 20}
end

function m.setx(p: point, v: integer)
	p.x = v
end

function m.sety(p: point, v: integer)
	p.y = v
end

function m.setany(t: {x: any}, v: any)
	t.x = v
end

function m.setnil(t: {x: nil})
	t.x = nil
end

return m

